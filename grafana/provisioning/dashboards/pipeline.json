    {
      "id": 2,
      "title": "Top 10 Most Polluted Cities \u2014 PM2.5",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(window_start, '1m'),\n  city AS metric,\n  ROUND(AVG(avg_pm2_5)::numeric, 2) AS \"PM2.5\"\nFROM sensor_aggregates\nWHERE $__timeFilter(window_start)\n  AND city IN (\n    SELECT city FROM sensor_aggregates\n    WHERE window_start > NOW() - INTERVAL '1 hour'\n    GROUP BY city ORDER BY AVG(avg_pm2_5) DESC LIMIT 10\n  )\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "unit": "\u00b5g/m\u00b3"
        },
        "overrides": []
      }
    },
