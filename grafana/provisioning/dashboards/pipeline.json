            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(window_start, '1m'),\n  SUM(reading_count) AS \"Events\"\nFROM sensor_aggregates\nWHERE $__timeFilter(window_start)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
