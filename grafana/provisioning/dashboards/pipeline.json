    {
      "id": 5,
      "title": "Alert Onsets per 5 min",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 26
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, '5m'),\n  city AS metric,\n  COUNT(*) AS \"Alerts\"\nFROM air_quality_alerts\nWHERE event_type = 'onset'\n  AND $__timeFilter(created_at)\n  AND city = CASE WHEN '${city:raw}' = 'All' THEN city ELSE '${city:raw}' END\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
