          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (sensor_id)\n  station_name,\n  latitude,\n  longitude,\n  ROUND(avg_aqi::numeric, 1) AS avg_aqi,\n  reading_count\nFROM sensor_aggregates\nORDER BY sensor_id, window_start DESC",
