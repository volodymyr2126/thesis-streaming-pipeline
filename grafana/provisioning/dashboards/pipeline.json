        },
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 9,
      "title": "Pipeline Latency (Flink window close \u2192 TimescaleDB insert)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(window_start, '1m'),\n  ROUND(AVG(EXTRACT(EPOCH FROM (inserted_at - window_end)) * 1000)::numeric, 0) AS \"Latency (ms)\"\nFROM sensor_aggregates\nWHERE $__timeFilter(window_start)\n  AND inserted_at > window_end\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "showLegend": false
        }
