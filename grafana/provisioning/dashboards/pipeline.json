    {
      "id": 4,
      "title": "Active Alerts",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  created_at                         AS \"Time\",\n  city                               AS \"City\",\n  event_type                         AS \"Event\",\n  severity                           AS \"Severity\",\n  ROUND(peak_pm2_5::numeric, 1)      AS \"Peak PM2.5\",\n  ROUND(avg_aqi::numeric, 0)         AS \"AQI\",\n  trend                              AS \"Trend\",\n  duration_minutes                   AS \"Duration (min)\",\n  consecutive_windows                AS \"Windows\"\nFROM air_quality_alerts\nWHERE $__timeFilter(created_at)\n  AND city = CASE WHEN '${city:raw}' = 'All' THEN city ELSE '${city:raw}' END\nORDER BY created_at DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
